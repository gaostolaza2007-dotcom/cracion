# Variables de entorno opcionales para cracion AN (no requiere claves ni secretos).
# NUNCA subas un archivo .env con datos personales a Git (ya esta en .gitignore).

# Ruta manual al ejecutable de Blender si no esta en la ruta estandar del sistema.
# BLENDER_PATH=C:\Program Files\Blender Foundation\Blender 5.2\blender.exe

# Carpeta donde se guardan los archivos .blend, renders y exportaciones.
# Si se omite, se usa automaticamente <Escritorio>\cracion-AN.
# CRACION_AN_DIR=
